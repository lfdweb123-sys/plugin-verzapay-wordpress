msgid "You will be redirected to a secure payment page."
msgstr "Será redirecionado para uma página de pagamento segura."

msgid "Checkout note: phone format"
msgstr ""

msgid ""
"Enter your phone number in international format, with the country code of "
"your billing country."
msgstr ""
"Indique o seu telefone no formato internacional, com o indicativo do país de"
" faturação."

msgid "Phone field label"
msgstr ""

